# Copy to .env and fill in for local runs (or pass as --secrets/--env to `hf jobs`)
HF_TOKEN=hf_xxx
FIXTURES=Arsenal vs Newcastle,Man City vs Chelsea
ODDS_DATASET_REPO=your-username/epl-ah-tracker

# Optional: real odds provider (falls back to mock odds if unset)
ODDS_API_URL=
ODDS_API_KEY=

# agent/run_agentworld.py (Qwen-AgentWorld-35B-A3B over an OpenAI-compatible
# vLLM/SGLang server you run separately — see agent/agentworld-setup.md)
AGENTWORLD_BASE_URL=http://localhost:8000/v1
AGENTWORLD_API_KEY=EMPTY
AGENTWORLD_MODEL=Qwen/Qwen-AgentWorld-35B-A3B
